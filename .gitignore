# ==============================================================================
# 1. 보안 및 인증 정보 (Secrets & Credentials) - [절대 업로드 금지]
# ==============================================================================
# 환경변수 파일
.env
.env.*
*.env
env.local
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# GCP / Cloud 인증 키 및 서비스 계정 파일
*credentials*.json
*secret*.json
service_account*.json
client_secret*.json
gcp-key*.json
*.gcp.json
token.json
authorized_user.json
oauth2_tokens*

# SSL 인증서 및 비밀키 파일
*.key
*.pem
*.crt
*.cer
*.der
*.p12
*.pfx
*.csr

# SSH 키 및 PuTTY 키 파일
id_rsa*
id_ed25519*
google_compute_engine*
*.ppk

# ==============================================================================
# 2. 실행 및 배포 로그 (Logs & Runtime Records)
# ==============================================================================
*.log
*.log.*
logs/
deployment_process.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==============================================================================
# 3. Python 빌드 및 바이트코드 (Bytecode & Caches)
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ==============================================================================
# 4. 가상환경 (Virtual Environments)
# ==============================================================================
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
myenv/

# ==============================================================================
# 5. 주피터 노트북 캐시 (Jupyter Notebook Checkpoints)
# ==============================================================================
.ipynb_checkpoints/
*-checkpoint.ipynb

# ==============================================================================
# 6. 압축 아카이브 파일 (Bundles & Archives)
# ==============================================================================
*.tar
*.tar.gz
*.tgz
*.zip
*.7z
*.rar
chatbot_app.tar.gz

# ==============================================================================
# 7. 에디터 및 OS 캐시 파일 (IDE & OS Artifacts)
# ==============================================================================
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

# 임시 파일
*.tmp
*.temp
*~
